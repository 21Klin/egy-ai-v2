// DRAFT — not yet deployed. Review with the project owner before
// publishing (Firebase console > Firestore Database > Rules, or
// `firebase deploy --only firestore:rules`).
//
// Model (task 0b): the public profile page no longer reads users/{uid}
// directly — it reads publicProfiles/{uid}, a small mirror doc that
// contains only the owner's displayName/createdAt and whichever stats
// they've toggled on (no email, no hidden balances). That split is
// what lets users/{uid} become fully private below.
//
//  - users/{uid}            — the private profile doc (email, display
//                              name, visibility settings). Owner-only,
//                              both read and write.
//  - users/{uid}/**          — everything nested (wallet, trades,
//                              gaRuns, ...) is private: only that
//                              account may read or write it.
//  - publicProfiles/{uid}    — the public mirror. Anyone (including
//                              logged-out visitors) can read it; only
//                              the owner can write it.
//  - everything else         — denied by default.
//
// (Dropped from the previously-deployed ruleset: userTrades/{uid},
// usernames/{username}, and profiles/{uid} — confirmed via a full
// source search that nothing in the app reads or writes any of those
// paths, on this branch or on main. Safe to remove.)

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /publicProfiles/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
